# Required when this Engine Host is deployed: same OrbitFS Supabase project used by Panel
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
ORBITFS_DB_SECRET=YOUR_SERVER_DATABASE_SECRET

# Required when this Engine Host is deployed: installation-specific service URLs
ORBITFS_PANEL_URL=https://YOUR_PANEL.vercel.app
ORBITFS_ENGINE_HOST_URL=https://YOUR_ENGINE.vercel.app

# Optional licence verification tuning
ORBITFS_LICENSE_REFRESH_MINUTES=30
ORBITFS_LICENSE_TIMEOUT_MS=8000
ORBITFS_ENTITLEMENT_PUBLIC_KEY=
